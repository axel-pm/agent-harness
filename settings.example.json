{
  "permissions": {
    "defaultMode": "auto"
  },
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(supabase db push:*)",
      "Bash(vercel deploy --prod:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/plan-mode-unknowns-nudge.sh",
            "timeout": 10,
            "statusMessage": "Checking for unsurfaced unknowns..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-log-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-log-end.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
