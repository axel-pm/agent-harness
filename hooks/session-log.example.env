# Copy to ~/.claude/session-log/config.env and edit. Keep that copy, and any
# prompt or note files it names, out of this repository.

# The Markdown file the session-log hooks remind about and append drafts to.
# Without it, both hooks do nothing.
SESSION_LOG_FILE="$HOME/notes/session-log.md"

# Optional: only sessions started under this folder.
# SESSION_LOG_WORKSPACE="$HOME/Projects/"

# Optional: your own summariser prompt, replacing the default in session-log-summarize.py.
# SESSION_LOG_PROMPT="$HOME/.claude/session-log/prompt.md"

# Optional: your own SessionStart note. {log_file} and {drafts} are filled in.
# SESSION_LOG_NOTE="$HOME/.claude/session-log/start-note.md"
